from fastapi import APIRouter, HTTPException, status
from ..agent.schemas import AskRequest,AskResponse,AgentErrorResponse
from  ..agent.agent import agent

router = APIRouter(prefix="/agent", tags=["Agentic RAG"])

@router.post(
    "/ask",
    response_model=AskResponse,
    status_code=status.HTTP_200_OK,
    responses={500: {"model": AgentErrorResponse}},
    summary="Query the AI Agent",
    description="Submit a natural language question. The agent dynamically routes queries across SQL analytics, Knowledge Base vector search, or post retrieval tools."
)
async def ask_agent(request: AskRequest):
    try:
        inputs = {"messages": [("user", request.query)]}

        result = await agent.ainvoke(inputs)

        response = result["messages"][-1].content

        return AskResponse(
            query=request.query,
            answer=response
        )
    except Exception as e:
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Agent execution failed: {str(e)}"
        )